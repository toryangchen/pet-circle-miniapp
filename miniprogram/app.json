{
  "pages": [
    "pages/tabbar/home/index",
    "pages/tabbar/service/index",
    "pages/tabbar/message/index",
    "pages/tabbar/personal/index",
    "pages/profileEdit/index",
    "pages/publish/index",
    "pages/detail/pet-social/index",
    "pages/detail/conversation/index",
    "pages/detail/pet-social/comment/index"
  ],
  "tabBar": {
    "custom": true,
    "list": [
      { "pagePath": "pages/tabbar/home/index", "text": "首页" },
      { "pagePath": "pages/tabbar/service/index", "text": "服务" },
      { "pagePath": "pages/tabbar/message/index", "text": "消息" },
      { "pagePath": "pages/tabbar/personal/index", "text": "我的" }
    ]
  },
  "usingComponents": {
    "navigation-bar": "components/navigation-bar/index"
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom"
  },
  "style": "v2",
  "rendererOptions": {
    "skyline": {
      "disableABTest": true,
      "defaultDisplayBlock": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "resolveAlias": {
    "~/*": "/*",
    "@utils/*": "utils/*"
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
