<!--miniprogram/custom-tab-bar/index.wxml-->
<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar-item"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view wx:if="{{index === 2}}" class="publish-view">
      <image class="raw-logo" src="/assets/logo-paw.png"></image>
      <view class="text">发布</view>
    </view>
    <view wx:else class="{{ selected === index ? 'selected-text' : 'normal-text' }}"
      >{{item.text}}</view
    >
  </view>
</view>
