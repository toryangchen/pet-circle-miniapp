<view class="pc-card feed-card custom-class {{fixedImageHeight ? 'feed-card--fixed-image' : ''}}">
  <view class="feed-card__img-content">
    <image class="feed-card__image" src="{{item.image}}" mode="{{imageMode}}"></image>
  </view>

  <view class="feed-card__body">
    <view wx:if="{{showBadge && item.badge}}">
      <view class="pc-chip pc-chip--warm">
        <text>{{item.badge}}</text>
      </view>
    </view>

    <text class="feed-card__title" overflow="ellipsis" max-lines="2"> {{item.title}} </text>
    <view class="feed-card__meta">
      <image
        wx:if="{{item.authorAvatarUrl}}"
        class="feed-card__avatar"
        src="{{item.authorAvatarUrl}}"
      ></image>
      <view wx:else class="feed-card__avatar feed-card__avatar--fallback">
        <text>宠</text>
      </view>
      <text class="feed-card__author">{{item.author}}</text>
      <view class="feed-card__spacer"></view>
      <image
        class="feed-card__love"
        src="/assets/icon-love{{item.favorited ? '-active' : ''}}.svg"
      />
      <text>{{item.favoriteCount || '0'}}</text>
    </view>
  </view>
</view>
