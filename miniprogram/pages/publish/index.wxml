<navigation-bar back title="发布" background="#ffffff"></navigation-bar>
<view class="publish-screen">
  <view class="pc-page-body publish-body">
    <view class="publish-panel">
      <view class="publish-image-grid" id="publish-image-grid">
        <view
          wx:for="{{imageList}}"
          wx:key="id"
          class="publish-image-card {{draggingImageId === item.id ? 'publish-image-card--dragging' : ''}}"
          data-image-id="{{item.id}}"
          data-index="{{index}}"
          bindlongpress="startImageDrag"
          catchtouchmove="onImageDragMove"
          bindtouchend="finishImageDrag"
          bindtouchcancel="finishImageDrag"
        >
          <image
            class="publish-image-card__image"
            src="{{item.previewUrl}}"
            mode="aspectFill"
          ></image>
          <view wx:if="{{item.uploadStatus !== 'success'}}" class="publish-image-card__status">
            {{item.uploadStatus === 'uploading' ? '上传中' : '上传失败'}}
          </view>
          <view
            class="publish-image-card__remove"
            data-image-id="{{item.id}}"
            catchtap="removeImage"
          >
            <text>×</text>
          </view>
        </view>

        <view
          wx:if="{{imageList.length < maxImageCount}}"
          class="publish-media publish-media--adder"
          bindtap="handleImageTap"
        >
          <text class="publish-media__plus">+</text>
        </view>
      </view>
      <text class="publish-image-tip">最多上传3张，可长按拖动排序</text>

      <textarea
        class="publish-title-input"
        placeholder="添加标题"
        placeholder-class="publish-placeholder"
        value="{{titleInput}}"
        maxlength="30"
        auto-height
        bindinput="handleTitleInput"
      />

      <textarea
        class="publish-content-input"
        placeholder="添加正文或发语音"
        placeholder-class="publish-placeholder"
        value="{{contentInput}}"
        maxlength="500"
        bindinput="handleContentInput"
      />
    </view>

    <scroll-view class="publish-tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="publish-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="publish-tab {{item.key === currentTab ? 'publish-tab--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchTab"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{currentTab !== 'PET_SOCIAL'}}" class="publish-form-card">
      <view wx:for="{{currentFields}}" wx:key="key" class="publish-field-block">
        <picker
          wx:if="{{item.inputType === 'picker'}}"
          range="{{item.options}}"
          value="{{item.optionIndex}}"
          data-field-key="{{item.key}}"
          bindchange="handleFieldPickerChange"
        >
          <view class="publish-field-row">
            <text class="publish-field-row__label">{{item.label}}</text>
            <view class="publish-field-row__value-wrap">
              <view
                class="publish-field-row__value {{!item.value ? 'publish-field-row__value--placeholder' : ''}}"
              >
                {{item.value || item.placeholder}}
              </view>
              <image
                class="publish-field-row__arrow-icon"
                src="/assets/icon-arrow-right.png"
                mode="aspectFit"
              ></image>
            </view>
          </view>
        </picker>

        <view
          wx:else
          class="publish-field-row"
          data-field-key="{{item.key}}"
          bindtap="openFieldDialog"
        >
          <text class="publish-field-row__label">{{item.label}}</text>
          <view class="publish-field-row__value-wrap">
            <view
              class="publish-field-row__value {{!item.value ? 'publish-field-row__value--placeholder' : ''}}"
            >
              {{item.value || item.placeholder}}
            </view>
            <image
              class="publish-field-row__arrow-icon"
              src="/assets/icon-arrow-right.png"
              mode="aspectFit"
            ></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="publish-footer">
    <button
      class="publish-footer__button {{isPublishEnabled ? 'publish-footer__button--enabled' : 'publish-footer__button--disabled'}}"
      disabled="{{!isPublishEnabled}}"
      bindtap="previewPublish"
    >
      {{isSubmitting ? '发布中...' : '发布'}}
    </button>
  </view>

  <view wx:if="{{isFieldDialogVisible}}" class="publish-field-editor" bindtap="dismissFieldEditor">
    <view
      class="publish-field-editor__panel"
      style="bottom: {{fieldEditorKeyboardHeight}}px"
      catchtap="noop"
    >
      <view class="publish-field-editor__title">{{fieldEditorLabel}}</view>
      <view class="publish-field-editor__input-wrap">
        <textarea
          class="publish-field-editor__input {{fieldEditorInputType === 'textarea' ? 'publish-field-editor__input--textarea' : ''}}"
          value="{{fieldEditorValue}}"
          placeholder="{{fieldEditorPlaceholder}}"
          placeholder-class="publish-placeholder"
          maxlength="{{fieldEditorInputType === 'textarea' ? 120 : 50}}"
          focus="{{fieldEditorInputFocused}}"
          auto-focus
          auto-height
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
          bindinput="handleDialogFieldInput"
          bindkeyboardheightchange="onFieldEditorKeyboardHeightChange"
        />
      </view>
      <view class="publish-field-editor__action-wrap">
        <view
          wx:if="{{canConfirmFieldEditor}}"
          class="publish-field-editor__confirm"
          bindtap="confirmFieldEditor"
        >
          确定
        </view>
        <view wx:else class="publish-field-editor__confirm-disabled">确定</view>
      </view>
    </view>
  </view>
</view>
