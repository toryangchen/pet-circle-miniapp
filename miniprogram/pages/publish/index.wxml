<navigation-bar back title="发布" background="#ffffff"></navigation-bar>
<view class="publish-screen">
  <view class="pc-page-body publish-body">
    <view class="publish-panel">
      <view class="publish-media-row">
        <view class="publish-media publish-media--adder" bindtap="handleImageTap">
          <text class="publish-media__plus">+</text>
        </view>
      </view>

      <input
        class="publish-title-input"
        placeholder="添加标题"
        placeholder-class="publish-placeholder"
        value="{{titleInput}}"
        maxlength="30"
        bindinput="handleTitleInput"
      />

      <textarea
        class="publish-content-input"
        placeholder="添加正文或发语音"
        placeholder-class="publish-placeholder"
        value="{{contentInput}}"
        maxlength="500"
        bindinput="handleContentInput"
      />
    </view>

    <scroll-view class="publish-tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="publish-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="publish-tab {{item.key === currentTab ? 'publish-tab--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchTab"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{currentTab !== 'PET_SOCIAL'}}" class="publish-form-card">
      <view wx:for="{{currentFields}}" wx:key="key" class="publish-field-block">
        <view class="publish-field-row" data-field-key="{{item.key}}" bindtap="activateField">
          <text class="publish-field-row__label">{{item.label}}</text>
          <view class="publish-field-row__value-wrap">
            <view
              class="publish-field-row__value {{!item.value ? 'publish-field-row__value--placeholder' : ''}}"
            >
              {{item.value || item.placeholder}}
            </view>
            <image
              class="publish-field-row__arrow-icon"
              src="/assets/icon-arrow-right.png"
              mode="aspectFit"
            ></image>
          </view>
        </view>

        <view wx:if="{{item.isActive}}" class="publish-field-editor">
          <picker
            wx:if="{{item.inputType === 'picker'}}"
            range="{{activeFieldOptions}}"
            value="{{activeFieldOptionIndex}}"
            bindchange="handleFieldPickerChange"
          >
            <view class="publish-field-picker">点击选择{{activeFieldLabel}}</view>
          </picker>

          <input
            wx:elif="{{item.inputType === 'text'}}"
            class="publish-field-input"
            value="{{activeFieldValue}}"
            placeholder="{{activeFieldPlaceholder}}"
            placeholder-class="publish-placeholder"
            maxlength="50"
            focus
            bindinput="handleFieldInput"
          />

          <textarea
            wx:else
            class="publish-field-textarea"
            value="{{activeFieldValue}}"
            placeholder="{{activeFieldPlaceholder}}"
            placeholder-class="publish-placeholder"
            maxlength="120"
            auto-height
            focus
            bindinput="handleFieldInput"
          />

          <view class="publish-field-editor__footer">
            <text class="publish-field-editor__done" bindtap="finishFieldEdit">完成</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="publish-footer">
    <view class="publish-footer__tip">
      <view>人工审核后即发布成功，</view>
      <view>预计 3 ~ 5 分钟完成审核</view>
    </view>
    <button
      class="publish-footer__button {{isPublishEnabled ? 'publish-footer__button--enabled' : 'publish-footer__button--disabled'}}"
      disabled="{{!isPublishEnabled}}"
      bindtap="previewPublish"
    >
      发布
    </button>
  </view>
</view>
