<view class="personal-hero">
  <image class="personal-hero__bg" src="{{profile.background}}" mode="aspectFill"></image>
  <view class="personal-hero__frost"> </view>
</view>

<scroll-view
  class="scroll-view"
  scroll-y
  enhanced="{{true}}"
  bounces="{{false}}"
  fast-deceleration="{{true}}"
  show-scrollbar="{{false}}"
  type="custom"
  lower-threshold="120"
  bindscroll="onScroll"
  bindscrolltolower="onScrollToLower"
>
  <sticky-section push-pinned-header="{{false}}">
    <sticky-header>
      <view
        class="sticky-header-content"
        style="height: {{pageDistance.stickyHeight}}px; opacity: {{pageDistance.opacityRate}}; visibility: {{ pageDistance.opacityRate <= 0 ? 'hidden': 'visible'  }};"
      >
        <image class="header-bg" src="{{profile.background}}"></image>
        <view class="navbar-holder" style="height: {{pageDistance.stickyHeight}}px; ">
          <image
            class="top-avatar"
            style="height: {{pageDistance.menuHeight}}px; width: {{pageDistance.menuHeight}}px; margin-top: {{pageDistance.menuTop * pageDistance.opacityRate}}px;"
            src="{{profile.avatar}}"
            mode="aspectFill"
          ></image>
        </view>
      </view>
    </sticky-header>

    <list-view>
      <view class="personal-profile">
        <view class="personal-user">
          <image class="personal-avatar" src="{{profile.avatar}}" mode="aspectFill"></image>

          <view class="personal-meta">
            <text class="personal-name">{{profile.name}}</text>
            <view class="personal-meta__row">
              <view class="personal-status">{{profile.status}}</view>
              <text class="personal-subtitle">{{profile.subtitle}}</text>
            </view>
          </view>
        </view>

        <view class="personal-actions">
          <view class="personal-stats">
            <view wx:for="{{stats}}" wx:key="label" class="personal-stat">
              <text class="personal-stat__value">{{item.value}}</text>
              <text class="personal-stat__label">{{item.label}}</text>
            </view>
          </view>

          <view class="personal-edit" bindtap="editProfile">编辑资料</view>
        </view>
      </view>

      <view class="personal-shortcuts">
        <view wx:for="{{shortcuts}}" wx:key="title" class="personal-shortcut">
          <text class="personal-shortcut__title">{{item.title}}</text>
          <text class="personal-shortcut__summary">{{item.summary}}</text>
        </view>
      </view>
    </list-view>
  </sticky-section>

  <sticky-section class="section">
    <sticky-header>
      <view
        class="personal-tabs"
        style="border-radius: {{pageDistance.tabRadius}}rpx {{pageDistance.tabRadius}}rpx 0 0; margin: 0 {{pageDistance.tabSpace}}rpx;"
      >
        <view wx:for="{{tabs}}" wx:key="*this" class="personal-tab-wrap">
          <view
            class="personal-tab {{activeTab === item ? 'personal-tab--active' : ''}}"
            data-tab="{{item}}"
            bindtap="switchTab"
          >
            <text>{{item}}</text>
            <view class="personal-tab__line"></view>
          </view>
        </view>
      </view>
      <view class="personal-divider"></view>
    </sticky-header>

    <view
      wx:if="{{activeTab === '发布' && isLoadingPosts && posts.length === 0}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:elif="{{activeTab === '收藏' && isLoadingFavorites && favoritePosts.length === 0}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:elif="{{activeTab === '浏览' && isLoadingHistory && historyPosts.length === 0}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <grid-view
      wx:elif="{{activeTab === '发布' && posts.length > 0}}"
      class="personal-panel personal-post-grid"
      type="masonry"
      cross-axis-count="2"
      main-axis-gap="{{gap}}"
      cross-axis-gap="{{gap}}"
      padding="{{[8,4,8,4]}}"
    >
      <block wx:for="{{posts}}" wx:key="id">
        <open-container
          closed-elevation="{{closedElevation}}"
          closed-border-radius="{{closedBorderRadius}}"
          open-elevation="{{openElevation}}"
          open-border-radius="{{openBorderRadius}}"
          transition-type="{{type}}"
          transition-duration="{{duration}}"
          data-route="{{item.route}}"
          data-post-id="{{item.id}}"
          bindtap="openPostDetail"
        >
          <feed-card item="{{item}}" show-badge="{{true}}"></feed-card>
        </open-container>
      </block>
    </grid-view>

    <grid-view
      wx:elif="{{activeTab === '收藏' && favoritePosts.length > 0}}"
      class="personal-panel personal-post-grid"
      type="masonry"
      cross-axis-count="2"
      main-axis-gap="{{gap}}"
      cross-axis-gap="{{gap}}"
      padding="{{[8,4,8,4]}}"
    >
      <block wx:for="{{favoritePosts}}" wx:key="id">
        <open-container
          closed-elevation="{{closedElevation}}"
          closed-border-radius="{{closedBorderRadius}}"
          open-elevation="{{openElevation}}"
          open-border-radius="{{openBorderRadius}}"
          transition-type="{{type}}"
          transition-duration="{{duration}}"
          data-route="{{item.route}}"
          data-post-id="{{item.id}}"
          bindtap="openPostDetail"
        >
          <feed-card item="{{item}}" show-badge="{{true}}"></feed-card>
        </open-container>
      </block>
    </grid-view>

    <grid-view
      wx:elif="{{activeTab === '浏览' && historyPosts.length > 0}}"
      class="personal-panel personal-post-grid"
      type="masonry"
      cross-axis-count="2"
      main-axis-gap="{{gap}}"
      cross-axis-gap="{{gap}}"
      padding="{{[8,4,8,4]}}"
    >
      <block wx:for="{{historyPosts}}" wx:key="id">
        <open-container
          closed-elevation="{{closedElevation}}"
          closed-border-radius="{{closedBorderRadius}}"
          open-elevation="{{openElevation}}"
          open-border-radius="{{openBorderRadius}}"
          transition-type="{{type}}"
          transition-duration="{{duration}}"
          data-route="{{item.route}}"
          data-post-id="{{item.id}}"
          bindtap="openPostDetail"
        >
          <feed-card item="{{item}}" show-badge="{{true}}"></feed-card>
        </open-container>
      </block>
    </grid-view>

    <view wx:else class="personal-panel personal-empty">
      <view class="personal-empty__icon-wrap">
        <image class="personal-empty__icon" src="/assets/logo-paw.png" mode="aspectFit"></image>
      </view>
      <text class="personal-empty__title">{{emptyState.title}}</text>
      <text class="personal-empty__summary">{{emptyState.summary}}</text>
      <view class="personal-empty__button" bindtap="goCreate">{{emptyState.cta}}</view>
    </view>

    <view
      wx:if="{{activeTab === '发布' && isLoadingMorePosts}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:elif="{{activeTab === '收藏' && isLoadingMoreFavorites}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:elif="{{activeTab === '浏览' && isLoadingMoreHistory}}"
      class="personal-panel pc-grid-loading"
    >
      <view wx:for="{{[1, 2]}}" wx:key="*this" class="pc-grid-skeleton">
        <view class="pc-grid-skeleton__image"></view>
        <view class="pc-grid-skeleton__body">
          <view class="pc-grid-skeleton__line"></view>
          <view class="pc-grid-skeleton__line pc-grid-skeleton__line--short"></view>
          <view class="pc-grid-skeleton__meta">
            <view class="pc-grid-skeleton__avatar"></view>
            <view class="pc-grid-skeleton__line pc-grid-skeleton__meta-line"></view>
          </view>
        </view>
      </view>
    </view>

    <view
      wx:elif="{{activeTab === '发布' && !hasMore && page > 1 && posts.length > 0}}"
      class="personal-loading"
    >
      <text>已经到底啦</text>
    </view>

    <view
      wx:elif="{{activeTab === '收藏' && !favoriteHasMore && favoritePage > 1 && favoritePosts.length > 0}}"
      class="personal-loading"
    >
      <text>已经到底啦</text>
    </view>

    <view
      wx:elif="{{activeTab === '浏览' && !historyHasMore && historyPage > 1 && historyPosts.length > 0}}"
      class="personal-loading"
    >
      <text>已经到底啦</text>
    </view>
  </sticky-section>
</scroll-view>
