<view class="pc-screen my-screen">
  <view class="my-hero-bg"></view>

  <view class="my-topbar">
    <view class="my-topbar__status">
      <text>9:41</text>
      <text>5G 100%</text>
    </view>
    <view class="my-topbar__nav">
      <view class="pc-topbar__ghost"></view>
      <text class="pc-topbar__title">{{title}}</text>
      <view class="pc-topbar__ghost"></view>
    </view>
  </view>

  <scroll-view
    class="my-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    lower-threshold="120"
    bindscrolltolower="loadMorePosts"
  >
    <view class="pc-page-body">
      <view class="my-hero pc-card">
        <view class="my-profile">
          <view class="my-avatar">
            <image
              wx:if="{{avatarUrl}}"
              class="my-avatar__image"
              src="{{avatarUrl}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="my-avatar__fallback"
              >{{nickname ? nickname.slice(0, 1) : '宠'}}</view
            >
          </view>
          <view class="my-profile__meta">
            <text class="my-profile__name">{{nickname}}</text>
            <view class="my-profile__row">
              <view class="pc-chip pc-chip--soft">{{phoneStatus}}</view>
              <text class="my-profile__phone">{{phoneMask}}</text>
            </view>
          </view>
        </view>

        <view class="my-stats">
          <view wx:for="{{stats}}" wx:key="label" class="my-stat">
            <text class="my-stat__value">{{item.value}}</text>
            <text class="my-stat__label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="my-body">
        <view class="my-section">
          <text class="my-section__title">常用入口</text>
          <view class="my-action-list">
            <view wx:for="{{actions}}" wx:key="id" class="my-action pc-card">
              <view class="my-action__copy">
                <text class="my-action__title">{{item.title}}</text>
                <text class="my-action__summary">{{item.summary}}</text>
              </view>
              <text class="my-action__arrow">›</text>
            </view>
          </view>
        </view>

        <view class="my-section">
          <text class="my-section__title">内容管理</text>
          <view class="my-content-block">
            <view class="my-content-head">
              <text class="my-content-head__title">我的收藏</text>
              <text class="my-content-head__count">{{favorites.length}} 条</text>
            </view>
            <view class="my-content-list">
              <view
                wx:for="{{favorites}}"
                wx:key="id"
                class="my-content-card"
                bindtap="openFavorite"
                data-route="{{item.route}}"
              >
                <image
                  class="my-content-card__image"
                  src="{{item.image}}"
                  mode="aspectFill"
                ></image>
                <view class="my-content-card__body">
                  <view class="pc-chip pc-chip--soft">{{item.badge}}</view>
                  <text class="my-content-card__title">{{item.title}}</text>
                  <text class="my-content-card__summary">{{item.summary}}</text>
                  <text class="my-content-card__meta">{{item.meta}}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="my-content-block">
            <view class="my-content-head">
              <text class="my-content-head__title">我的发布</text>
              <text class="my-content-head__count">{{postTotal}} 条</text>
            </view>
            <scroll-view class="my-post-tabs" scroll-x enhanced show-scrollbar="{{false}}">
              <view class="my-post-tabs__list">
                <view
                  wx:for="{{postStatusTabs}}"
                  wx:key="key"
                  class="my-post-tabs__item {{currentPostStatus === item.key ? 'my-post-tabs__item--active' : ''}}"
                  bindtap="switchPostStatus"
                  data-status="{{item.key}}"
                >
                  {{item.label}}
                </view>
              </view>
            </scroll-view>
            <view class="my-post-list">
              <view
                wx:for="{{posts}}"
                wx:for-item="post"
                wx:key="id"
                class="my-post-card"
                bindtap="openPost"
                data-route="{{post.route}}"
              >
                <view class="my-post-card__head">
                  <text class="my-post-card__title">{{post.title}}</text>
                  <view class="my-post-card__status my-post-card__status--{{post.status}}">
                    {{post.status}}
                  </view>
                </view>
                <text class="my-post-card__summary">{{post.summary}}</text>
                <view wx:if="{{post.actions.length}}" class="my-post-card__actions">
                  <view
                    wx:for="{{post.actions}}"
                    wx:for-item="actionItem"
                    wx:key="key"
                    class="my-post-card__action"
                    catchtap="handlePostAction"
                    data-action="{{actionItem.key}}"
                    data-post-id="{{post.id}}"
                  >
                    {{actionItem.label}}
                  </view>
                </view>
              </view>
              <view wx:if="{{isPostLoadingMore}}" class="my-post-list__footer">加载更多中...</view>
              <view
                wx:elif="{{!postHasMore && posts.length}}"
                class="my-post-list__footer my-post-list__footer--end"
              >
                已经到底了
              </view>
              <view
                wx:elif="{{!posts.length}}"
                class="my-post-list__footer my-post-list__footer--empty"
              >
                当前筛选下还没有内容
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
