<navigation-bar title="服务"></navigation-bar>

<view class="service-tabs">
  <view
    wx:for="{{tabs}}"
    wx:key="*this"
    class="service-tab {{index === currentTab ? 'service-tab--active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text>{{item}}</text>
  </view>
</view>

<scroll-view
  class="service-scroll"
  scroll-y
  type="custom"
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
>
  <view class="pc-card service-hero">
    <text class="hero__title">{{highlightTitle}}</text>
    <text class="hero__summary">{{highlightSummary}}</text>

    <view class="service-tag-row">
      <view wx:for="{{tags}}" wx:key="*this" class="pc-chip pc-chip--soft">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <grid-view
    type="masonry"
    cross-axis-count="2"
    cross-axis-gap="{{gap}}"
    main-axis-gap="{{gap}}"
    padding="{{[0,0,10,0]}}"
  >
    <view wx:for="{{servicePosts}}" wx:key="id" data-route="{{item.route}}" bindtap="openDetail">
      <feed-card
        item="{{item}}"
        image-mode="aspectFill"
        fixed-image-height="{{true}}"
        show-badge="{{true}}"
      ></feed-card>
    </view>
  </grid-view>
</scroll-view>
