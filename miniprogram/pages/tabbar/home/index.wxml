<navigation-bar title="宠友圈"></navigation-bar>

<scroll-view
  class="home-scroll"
  scroll-y
  type="custom"
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
  lower-threshold="120"
  bindscrolltolower="onScrollToLower"
>
  <view class="pc-card home-hero">
    <view>
      <view class="pc-chip pc-chip--warm">西安社区</view>
    </view>

    <text class="hero__title">{{heroTitle}}</text>
    <text class="hero__summary">{{heroSummary}}</text>

    <view class="home-tags">
      <view wx:for="{{tags}}" wx:key="*this" class="pc-chip pc-chip--soft">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <grid-view
    type="masonry"
    cross-axis-count="2"
    main-axis-gap="{{gap}}"
    cross-axis-gap="{{gap}}"
    padding="{{[0,0,10,0]}}"
  >
    <view
      wx:for="{{featuredPosts}}"
      wx:key="id"
      class="pc-card home-card"
      data-route="{{item.route}}"
      bindtap="onTapPost"
    >
      <view class="home-card__img-content">
        <image class="home-card__image" src="{{item.image}}" mode="widthFix"></image>
      </view>

      <view class="home-card__body">
        <text class="home-card__title" overflow="ellipsis" max-lines="2"> {{item.title}} </text>
        <view class="home-card__meta">
          <image class="img-avator" src="{{item.authorAvatarUrl}}"></image>
          <text>{{item.author}}</text>
          <view style="flex: 1"></view>
          <image
            class="icon-love"
            src="/assets/icon-love{{item.viewerState.favorited ? '-active' : ''}}.svg"
          />
          <text>{{item.stats.favoriteCount || '0'}}</text>
        </view>
      </view>
    </view>
  </grid-view>

  <view wx:if="{{isLoadingMore}}" class="pc-card">
    <text>正在加载更多宠友圈内容...</text>
  </view>

  <view wx:elif="{{!hasMore && featuredPosts.length > 0}}" class="pc-card">
    <text>已经到底啦，先逛逛这些内容。</text>
  </view>
</scroll-view>
