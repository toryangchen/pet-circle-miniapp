<navigation-bar title="编辑资料" back></navigation-bar>

<view class="profile-edit-page">
  <button
    class="profile-edit-avatar"
    hover-class="none"
    open-type="chooseAvatar"
    bind:chooseavatar="onChooseAvatar"
  >
    <view class="profile-edit-avatar__wrap">
      <image class="profile-edit-avatar__image" src="{{avatar}}" mode="aspectFit"></image>

      <view class="profile-edit-avatar__camera">
        <image
          class="profile-edit-avatar__camera-icon"
          src="/assets/profile-edit-camera.png"
          mode="aspectFit"
        ></image>
      </view>
    </view>
    <text class="profile-edit-avatar__hint">{{avatarHint}}</text>
  </button>

  <view class="profile-edit-card">
    <view
      wx:for="{{basicFields}}"
      wx:key="label"
      class="profile-edit-row"
      data-type="{{item.type}}"
      bindtap="handleFieldTap"
    >
      <text class="profile-edit-row__label">{{item.label}}</text>
      <view class="profile-edit-row__value-group">
        <input
          wx:if="{{item.type === 'nickname'}}"
          class="profile-edit-row__value"
          placeholder-style="color: #a2978c;font-weight: 500;font-size: 26rpx;"
          type="nickname"
          value="{{item.value}}"
          bindblur="bindNickNameInput"
          placeholder="请输入昵称"
        />

        <button
          class="btn-phone"
          wx:if="{{item.type === 'phoneMasked'}}"
          open-type="getPhoneNumber"
          hover-class="none"
          bindgetphonenumber="getPhoneNumber"
        >
          <text
            class="profile-edit-row__value {{!item.value ? 'profile-edit-row__value--placeholder' : '' }} "
            >{{item.value || '未绑定'}}</text
          >
        </button>

        <view wx:if="{{item.type === 'bgType'}}" class="profile-edit-row__preview">
          <image src="{{item.preview}}" />
          <view class="bg"></view>
        </view>

        <image class="icon-right" src="/assets/icon-arrow-right.png"></image>
      </view>
    </view>
  </view>

  <view class="profile-edit-card">
    <view
      wx:for="{{extraFields}}"
      wx:key="label"
      class="profile-edit-row"
      data-type="{{item.type}}"
      bindtap="handleFieldTap"
    >
      <text class="profile-edit-row__label">{{item.label}}</text>
      <view class="profile-edit-row__value-group">
        <picker
          wx:if="{{item.type === 'birthday'}}"
          mode="date"
          value="{{item.placeholder ? '' : item.value}}"
          end="{{maxBirthday}}"
          bindchange="handleBirthdayChange"
        >
          <text
            class="profile-edit-row__value {{item.placeholder ? 'profile-edit-row__value--placeholder' : ''}}"
            >{{item.value}}</text
          >
        </picker>

        <picker
          wx:elif="{{item.type === 'area'}}"
          mode="region"
          value="{{regionPickerValue}}"
          bindchange="handleRegionChange"
        >
          <text
            class="profile-edit-row__value {{item.placeholder ? 'profile-edit-row__value--placeholder' : ''}}"
            >{{item.value}}</text
          >
        </picker>

        <text
          wx:else
          class="profile-edit-row__value {{item.placeholder ? 'profile-edit-row__value--placeholder' : ''}}"
          >{{item.value}}</text
        >
        <image class="icon-right" src="/assets/icon-arrow-right.png"></image>
      </view>
    </view>
  </view>

  <text class="profile-edit-tip">{{footerTip}}</text>
</view>

<bg-type-sheet
  visible="{{isBgTypeSheetVisible}}"
  value="{{pendingBgType}}"
  options="{{bgTypeOptions}}"
  bind:close="handleBgTypeSheetClose"
  bind:change="handleBgTypeChange"
  bind:confirm="handleBgTypeConfirm"
></bg-type-sheet>
