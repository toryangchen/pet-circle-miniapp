<navigation-bar back>
  <view class="author-info" slot="title">
    <image src="{{authorAvator || '/assets/profile-pawpets-avatar.png'}}"></image>
    <text>{{authorName}}</text>
  </view>
</navigation-bar>

<scroll-view
  class="pet-social-scroll"
  scroll-y
  enhanced
  show-scrollbar="{{false}}"
  scroll-into-view="{{commentAnchor}}"
  scroll-with-animation
>
  <view class="pet-social-hero">
    <swiper
      class="pet-social-hero__swiper"
      current="{{heroCurrent}}"
      bindchange="onHeroSwiperChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="*this" class="pet-social-hero__item">
        <image
          class="pet-social-hero__image"
          src="{{item}}"
          mode="aspectFill"
          data-current="{{item}}"
          bindtap="previewHeroImage"
        ></image>
      </swiper-item>
    </swiper>
    <view wx:if="{{images.length}}" class="pet-social-hero__counter">
      <text>{{heroCurrent + 1}}/{{images.length}}</text>
    </view>
  </view>

  <view class="pet-social-content">
    <view wx:if="{{images.length}}" class="pet-social-indicator">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="pet-social-dot {{index === heroCurrent ? 'pet-social-dot--active' : ''}}"
      ></view>
    </view>

    <view class="pet-social-post">
      <view class="pet-social-tags">
        <view wx:for="{{tags}}" wx:key="*this" class="pet-social-tag">{{item}}</view>
      </view>
      <text class="pet-social-title">{{postTitle}}</text>
      <text class="pet-social-summary">{{summary}}</text>
      <view class="pet-social-meta">{{postMeta}}</view>
    </view>

    <view wx:if="{{isServiceDetail}}" class="pet-social-divider"></view>

    <view wx:if="{{isServiceDetail}}" class="pet-social-service-info">
      <text class="pet-social-section-title">服务信息</text>
      <view class="pet-social-service-grid">
        <view wx:for="{{serviceFields}}" wx:key="label" class="pet-social-service-field">
          <text class="pet-social-service-field__label">{{item.label}}</text>
          <text class="pet-social-service-field__value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isServiceDetail}}" class="pet-social-divider"></view>

    <view wx:if="{{isServiceDetail}}" class="pet-social-service-description">
      <text class="pet-social-section-title">服务说明</text>
      <text class="pet-social-service-description__content">{{serviceDescription}}</text>
    </view>

    <view class="pet-social-divider"></view>

    <view class="pet-social-comments">
      <view class="pet-social-comments__head">
        <text>共 {{commentCount}} 条评论</text>
      </view>

      <view wx:if="{{replyTargetId}}" class="pet-social-replying">
        <text>正在回复 {{replyTargetAuthor}}</text>
        <text bindtap="cancelReply">取消</text>
      </view>

      <view wx:if="{{comments.length}}" class="pet-social-comment-list">
        <view wx:for="{{comments}}" wx:key="id" class="pet-social-comment">
          <view class="pet-social-comment__row">
            <view class="pet-social-avatar pet-social-comment__avatar">
              <image
                src="{{item.author.avatarUrl || '/assets/profile-pawpets-avatar.png'}}"
                mode="aspectFill"
              ></image>
            </view>
            <view class="pet-social-comment__body">
              <text class="pet-social-comment__author">{{item.author.nickname || '宠友'}}</text>
              <text class="pet-social-comment__content">{{item.content}}</text>
              <view
                class="pet-social-comment__meta"
                data-comment-id="{{item.id}}"
                data-author="{{item.author.nickname || '宠友'}}"
                bindtap="startReply"
              >
                {{item.createdAt}} · 回复
              </view>
              <view wx:if="{{item.replies.length}}" class="pet-social-replies">
                <view wx:for="{{item.replies}}" wx:key="id" class="pet-social-reply">
                  <view class="pet-social-reply__body">
                    <text class="pet-social-reply__author"
                      >{{item.author.nickname || '宠友'}}：</text
                    >
                    <text class="pet-social-reply__content">{{item.content}}</text>
                  </view>
                  <text
                    wx:if="{{item.canDelete}}"
                    class="pet-social-reply__delete"
                    data-comment-id="{{item.id}}"
                    bindtap="deleteComment"
                    >删除</text
                  >
                </view>
              </view>
            </view>
            <text
              wx:if="{{item.canDelete}}"
              class="pet-social-comment__delete"
              data-comment-id="{{item.id}}"
              bindtap="deleteComment"
              >删除</text
            >
          </view>
          <view class="pet-social-comment__divider"></view>
        </view>
      </view>
      <view wx:else class="pet-social-comment-empty">
        <view class="pet-social-comment-empty__icon">
          <image src="/assets/message.svg" mode="aspectFit"></image>
        </view>
        <text class="pet-social-comment-empty__text">暂无评论，快来抢沙发</text>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{!isServiceDetail}}" class="pet-social-bottom">
  <view class="pet-social-bottom__input" bindtap="openCommentComposer">
    <image src="/assets/edit.png" mode="aspectFit"></image>
    <text>说点什么...</text>
  </view>
  <view class="pet-social-bottom__like" bindtap="toggleFavorite">
    <image src="/assets/icon-love{{favorited ? '-active' : '-black'}}.svg" mode="aspectFit"></image>
    <text>{{favoriteCount}}</text>
  </view>
  <button class="pet-social-bottom__share" open-type="share">
    <image src="/assets/share.png" mode="aspectFit"></image>
    <text>分享</text>
  </button>
</view>

<view wx:if="{{isServiceDetail}}" class="pet-social-service-bottom">
  <view class="pet-social-service-bottom__icon" bindtap="toggleFavorite">
    <image
      class="icon"
      src="/assets/icon-love{{favorited ? '-active' : '-black'}}.svg"
      mode="aspectFit"
    ></image>
    <text>{{favoriteCount}}</text>
  </view>
  <view class="pet-social-service-bottom__icon" bindtap="openCommentComposer">
    <image class="icon" src="/assets/message.svg" mode="aspectFit"></image>
    <text>{{commentCount}}</text>
  </view>
  <button class="pet-social-service-bottom__icon" open-type="share">
    <image src="/assets/share.png" mode="aspectFit"></image>
    <text>分享</text>
  </button>
  <button
    wx:if="{{!phoneAuthorized}}"
    class="pet-social-service-bottom__primary"
    open-type="getPhoneNumber"
    bindgetphonenumber="handleGetPhoneNumber"
    loading="{{isAuthorizingPhone}}"
  >
    {{isAuthorizingPhone ? '授权中...' : contactButtonLabel}}
  </button>
  <view wx:else class="pet-social-service-bottom__primary" bindtap="requestContact"
    >联系发布者</view
  >
</view>
