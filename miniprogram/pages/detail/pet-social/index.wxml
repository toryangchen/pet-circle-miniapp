<view class="pc-screen detail-screen detail-screen--pet-social">
  <view class="detail-topbar">
    <view class="pc-topbar__status">
      <text>9:41</text>
      <text>5G 100%</text>
    </view>
    <view class="detail-topbar__nav">
      <view class="detail-back" bindtap="goBack">‹</view>
        <view class="detail-author">
          <view class="detail-author__avatar">宠</view>
          <view class="detail-author__meta">
            <text class="detail-author__name">{{authorName}}</text>
            <text class="detail-author__sub">{{isLoading ? '加载中...' : '宠物圈 · 热门帖子'}}</text>
          </view>
        </view>
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="detail-hero">
      <image class="detail-hero__image" src="{{image}}" mode="aspectFill"></image>
      <view class="detail-dots">
        <view class="detail-dot detail-dot--active"></view>
        <view class="detail-dot"></view>
        <view class="detail-dot"></view>
      </view>
    </view>

    <view class="pc-page-body detail-body">
      <view class="pc-card detail-card">
        <view class="pc-chip pc-chip--warm">{{badge}}</view>
        <text class="detail-card__title">{{postTitle}}</text>
        <text class="detail-card__summary">{{summary}}</text>

        <view class="detail-meta">
          <view wx:for="{{stats}}" wx:key="label" class="detail-meta__item">
            <text class="detail-meta__value">{{item.value}}</text>
            <text class="detail-meta__label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="pc-card detail-section">
        <text class="detail-section__title">内容标签</text>
        <view class="detail-tag-row">
          <view wx:for="{{tags}}" wx:key="*this" class="detail-tag">{{item}}</view>
        </view>
      </view>

      <view class="pc-card detail-section">
        <text class="detail-section__title">互动入口</text>
        <view class="detail-action-row">
          <view wx:for="{{actions}}" wx:key="*this" class="detail-action">{{item}}</view>
        </view>
      </view>

      <view class="pc-card detail-section">
        <view class="detail-section__header">
          <text class="detail-section__title">评论区</text>
          <text class="detail-section__count">{{comments.length}} 条</text>
        </view>
        <view class="detail-comment-box">
          <view wx:if="{{replyTargetId}}" class="detail-comment-box__replying">
            <text>正在回复 {{replyTargetAuthor}}</text>
            <text bindtap="cancelReply">取消</text>
          </view>
          <input
            class="detail-comment-box__input"
            placeholder="{{commentPlaceholder}}"
            value="{{commentInput}}"
            bindinput="onCommentInput"
          />
          <button
            class="detail-comment-box__button {{isSubmittingComment || !commentInput ? 'detail-comment-box__button--disabled' : ''}}"
            disabled="{{isSubmittingComment || !commentInput}}"
            bindtap="submitComment"
          >
            {{isSubmittingComment ? '发送中' : '发送'}}
          </button>
        </view>
        <view wx:if="{{comments.length}}" class="detail-comment-list">
          <view wx:for="{{comments}}" wx:key="id" class="detail-comment">
            <view class="detail-comment__head">
              <view class="detail-comment__avatar">{{item.author.nickname ? item.author.nickname.slice(0, 1) : '宠'}}</view>
              <view class="detail-comment__meta">
                <text class="detail-comment__author">{{item.author.nickname || '宠友'}}</text>
                <text class="detail-comment__time">{{item.createdAt}}</text>
              </view>
            </view>
            <text class="detail-comment__content">{{item.content}}</text>
            <view class="detail-comment__reply-trigger" data-comment-id="{{item.id}}" data-author="{{item.author.nickname || '宠友'}}" bindtap="startReply">
              回复
            </view>
            <view wx:if="{{item.replies.length}}" class="detail-reply-list">
              <view wx:for="{{item.replies}}" wx:key="id" class="detail-reply">
                <text class="detail-reply__author">{{item.author.nickname || '宠友'}}：</text>
                <text class="detail-reply__content">{{item.content}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="detail-bottom detail-bottom--pet-social">
    <view class="detail-bottom__button detail-bottom__button--secondary" bindtap="toggleLike">
      {{liked ? '已点赞' : '点赞'}}
    </view>
    <view class="detail-bottom__button detail-bottom__button--secondary" bindtap="focusCommentInput">评论</view>
    <view class="detail-bottom__button detail-bottom__button--primary" bindtap="toggleFavorite">
      {{favorited ? '已收藏' : '收藏'}}
    </view>
  </view>
</view>
