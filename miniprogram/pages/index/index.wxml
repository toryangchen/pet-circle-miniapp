<view class="pc-screen home-screen">
  <view class="pc-topbar">
    <view class="pc-topbar__status">
      <text>9:41</text>
      <text>5G 100%</text>
    </view>
    <view class="pc-topbar__nav">
      <view class="pc-topbar__location">{{location}}</view>
      <text class="pc-topbar__title">{{title}}</text>
      <view class="pc-topbar__ghost"></view>
    </view>
  </view>

  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pc-page-body">
      <view class="pc-card home-hero">
        <view class="pc-chip pc-chip--warm">西安社区</view>
        <text class="home-hero__title">{{heroTitle}}</text>
        <text class="home-hero__summary">{{heroSummary}}</text>

        <view class="home-tags">
          <view wx:for="{{tags}}" wx:key="*this" class="home-tag">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="home-grid">
        <view
          wx:for="{{featuredPosts}}"
          wx:key="id"
          class="home-card"
          data-route="{{item.route}}"
          bindtap="onTapPost"
        >
          <image class="home-card__image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="home-card__body">
            <view class="home-card__badge">{{item.badge}}</view>
            <text class="home-card__title">{{item.title}}</text>
            <text class="home-card__summary">{{item.summary}}</text>
            <view class="home-card__meta">
              <text>{{item.author}}</text>
              <text>{{item.meta}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="home-section">
        <view class="home-section__head">
          <text class="home-section__title">继续浏览</text>
          <text class="home-section__link" bindtap="goService">查看服务</text>
        </view>

        <view class="home-list">
          <view class="home-list__item">
            <view class="home-list__dot home-list__dot--warm"></view>
            <view class="home-list__copy">
              <text class="home-list__title">领养和寄养内容更集中</text>
              <text class="home-list__summary">服务页会按结构化信息展示城市、价格和联系方式。</text>
            </view>
          </view>
          <view class="home-list__item">
            <view class="home-list__dot"></view>
            <view class="home-list__copy">
              <text class="home-list__title">发布入口统一在底部中央</text>
              <text class="home-list__summary">你可以在任意页面快速进入发布，先选类型再进入表单。</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <pet-tabbar current="home"></pet-tabbar>
</view>
